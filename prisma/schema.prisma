// Prisma schema for MultiBlog — see PLAN.md §4 for the data model rationale.
//
// **Run `npx prisma format` after editing this file, and read what it changed.** It
// rewrites the WHOLE file, not the block you touched, so anything it moves outside your
// own edit is pre-existing drift and belongs in its own commit rather than buried in
// yours. This file is format-clean as of the commit that added this note, so a run should
// now be a no-op plus your own block's realignment. `npm run check:schema` is the
// fail-if-dirty version; docs/DATABASE.md has the reasoning.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  // `views` is still a preview feature in Prisma 7.9 — it's what makes the
  // `view` block below generate a model at all. See PostActivity for why a
  // view earns its keep here.
  previewFeatures = ["views"]
}

// No `url` here: Prisma 7 rejects it in the schema (P1012). The CLI reads the
// connection string from prisma.config.ts's `datasource` block, and the
// runtime gets it via the PrismaPg adapter in src/lib/prisma.ts.
datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EDITOR
  AUTHOR
  AUTHORIZED
  COMMENTER

  @@map("role")
}

enum ModerationPolicy {
  INHERIT
  ALWAYS
  AUTO

  @@map("moderation_policy")
}

enum PublicationEventType {
  PUBLISHED
  UNPUBLISHED
  SCHEDULED
  SCHEDULE_CANCELED

  @@map("publication_event_type")
}

enum ThreadStatus {
  ACTIVE
  DETACHED
  RESOLVED

  @@map("thread_status")
}

enum CommentStatus {
  PENDING
  APPROVED
  SPAM
  DELETED

  @@map("comment_status")
}

// PLAN.md §12e — PRIVATE is byline authors plus ADMIN/EDITOR; SHARED is
// anyone with canViewDocs. No "unlisted" tier: with role gating underneath,
// it would have no threat model left to address.
enum DocVisibility {
  PRIVATE
  SHARED

  @@map("doc_visibility")
}

// PLAN.md §13d — an annotation's visibility/notification axis, orthogonal to
// moderation (annotations are never moderated, §12c). DRAFT never carries an
// inline mark and notifies nobody; LIVE is the ordinary posted state; RAISED
// is LIVE plus the doc's byline authors have been emailed.
enum AnnotationStatus {
  DRAFT
  LIVE
  RAISED

  @@map("annotation_status")
}

// PLAN.md §20b — which *mechanism* a part-anchor's offsets are expressed in.
// Null on a row means the anchor names the whole object, which is the only
// thing PR 1 writes (§20h); both writers arrive in PR 2.
//
// `POST_RANGE` is deliberately absent. It is honest only once part-anchors
// join comment_thread's publish-time remap (§5), and `ALTER TYPE … ADD VALUE`
// is cheap — an enum value with no writer for several sections is not (§20i).
enum SelectorKind {
  DOC_RANGE
  PDF_TEXT

  @@map("selector_kind")
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  slug             String           @unique
  emailVerified    DateTime?        @map("email_verified")
  name             String?
  image            String?
  passwordHash     String?          @map("password_hash")
  role             Role             @default(COMMENTER)
  moderationPolicy ModerationPolicy @default(INHERIT) @map("moderation_policy")
  color            String           @default("#5b8cff")
  adminInitials    String           @map("admin_initials")
  rowsPerPage      Int              @default(25) @map("rows_per_page")
  columnOrder      Json?            @map("column_order")
  createdAt        DateTime         @default(now()) @map("created_at")
  deletedByUserId  String?          @map("deleted_by_user_id")
  deletedAt        DateTime?        @map("deleted_at")

  // Landing-page contributor list (PLAN.md §17e/§17f). isListedContributor is
  // the only membership switch — self-service actions may clear it but never
  // set it (§17g/§17h); only updateUserIsListedContributor (admin-gated) sets
  // it true. contributorBlurb is TipTap JSON validated against pmBlurbSchema
  // on write, not a ydoc — one owner, no history, no concurrent editors
  // (§17f). contributorOrder is nullable (not @default(0)) so "unset" sorts
  // to the tail via `nulls: "last"` instead of tying everyone at the front.
  isListedContributor Boolean @default(false) @map("is_listed_contributor")
  contributorBlurb    Json?   @map("contributor_blurb")
  contributorOrder    Int?    @map("contributor_order")
  orcid               String? @map("orcid")
  website             String? @map("website")

  avatar                 UserAvatar?
  accounts               Account[]
  sessions               Session[]
  postAuthors            PostAuthor[]           @relation("PostAuthorUser")
  postAuthorGrants       PostAuthor[]           @relation("PostAuthorCreatedBy")
  commenter              Commenter?
  passwordResetTokens    PasswordResetToken[]
  commentStatusChanges   Comment[]              @relation("CommentStatusChangedBy")
  commentDeletions       Comment[]              @relation("CommentDeletedBy")
  publicationEvents      PostPublicationEvent[] @relation("PublicationEventActor")
  deletedBy              User?                  @relation("UserDeletedBy", fields: [deletedByUserId], references: [id])
  deletedUsers           User[]                 @relation("UserDeletedBy")
  postDeletions          Post[]                 @relation("PostDeletedBy")
  slugHistory            UserSlugHistory[]
  ydocSnapshots          YdocSnapshot[]         @relation("YdocSnapshotUser")
  docAuthors             DocAuthor[]
  docUpdates             Doc[]                  @relation("DocUpdatedBy")
  docDeletions           Doc[]                  @relation("DocDeletedBy")
  fileOwners             FileOwner[]
  fileUpdates            StoredFile[]           @relation("FileUpdatedBy")
  fileDeletions          StoredFile[]           @relation("FileDeletedBy")
  annotations            Annotation[]           @relation("AnnotationAuthor")
  annotationDeletions    Annotation[]           @relation("AnnotationDeletedBy")
  docLinks               DocLink[]
  docLinkGroups          DocLinkGroup[]
  invites                UserInvite[]           @relation("UserInviteRecipient")
  invitesSent            UserInvite[]           @relation("UserInviteSender")
  tagsCreated            Tag[]                  @relation("TagCreatedBy")
  tagDeletions           Tag[]                  @relation("TagDeletedBy")
  tagAssignments         TagAssignment[]        @relation("TagAssignedBy")
  tagAssignmentDeletions TagAssignment[]        @relation("TagAssignmentDeletedBy")
  anchoredLinksCreated   AnchoredLink[]         @relation("AnchoredLinkCreatedBy")
  anchoredLinkDeletions  AnchoredLink[]         @relation("AnchoredLinkDeletedBy")

  @@map("user")
}

// A self-hosted contributor avatar (PLAN.md §17n), stored as bytes rather
// than referenced by a remote URL. Three things about this shape are
// deliberate:
//
// 1. **Its own table, not a `Bytes` column on User.** src/app/users/page.tsx
//    queries with `include:` and no `select:`, which returns every scalar
//    column — an avatar column on `user` would drag up to 100 blobs into the
//    RSC payload on every /users page load, to render 32px circles. A
//    separate table cannot be reached by a wide select on `user`, so that
//    regression is structurally impossible rather than a rule to remember.
// 2. **`hash` is what makes the served URL immutable.** The route is
//    /api/avatar/<userId>/<hash>, so replacing an avatar changes its URL —
//    which is what lets the handler answer `Cache-Control: immutable`
//    without ever serving a stale image. It doubles as the ETag.
// 3. **`User.image` is deliberately left alone.** That column belongs to the
//    Auth.js adapter contract (`PrismaAdapter`, src/lib/auth.ts), which
//    specifies a string URL and would populate it from an OAuth provider's
//    profile. This table takes precedence over it at render time; the URL
//    column survives as the fallback for an OAuth-linked account that never
//    uploaded anything.
//
// userId is the primary key (not a separate id): one avatar per user, and
// the lookup the route handler does on every request is then a PK hit.
model UserAvatar {
  userId      String   @id @map("user_id")
  bytes       Bytes
  contentType String   @map("content_type")
  // Content hash of `bytes` — the URL path segment and the ETag.
  hash        String
  width       Int
  height      Int
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_avatar")
}

// Redirect sources for a user's past slugs — same shape as PostSlugHistory,
// kept as its own table rather than a shared polymorphic one since Prisma
// has no real polymorphic relation support (see PostSlugHistory's comment).
model UserSlugHistory {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_slug_history")
}

// Auth.js (NextAuth) Prisma adapter models — used for OAuth account linking.
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("account")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_token")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_token")
}

// An invite to an *already-created* user row: an admin creates the account,
// then invites the person to claim it. Full design: docs/EMAIL.md.
//
// **Several rows per user is the point, not an accident.** Unlike
// PasswordResetToken above — whose action deletes priors before creating,
// since a reset token is a one-shot credential with no reporting value —
// this table is the audit log the feature exists for: an admin re-sends
// when the first lands in spam, and "sent three times, clicked once, never
// accepted" is exactly what the /users columns answer. Nothing is ever
// deleted on send.
//
// clickedAt and acceptedAt are two columns, not one. A GET stamps clickedAt,
// including a corporate mail scanner's prefetch — which is fine, because
// that still proves the message was deliverable. acceptedAt can only come
// from the POST that sets a password, which no scanner can fake. One column
// would conflate "the mail arrived" with "the person is onboarded", and the
// first is what an admin deciding whether to re-send actually needs.
//
// `token` is the raw value; `tokenHash` is the lookup key. Keeping both is
// deliberate: the raw is nulled on accept/revoke (and swept on expiry) so a
// pending invite is the only one whose link is readable, while the hash
// survives forever — so a replayed link still finds its row and can say
// "already accepted" instead of "invalid". docs/EMAIL.md has what that trade
// buys and what it costs.
model UserInvite {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  invitedById String    @map("invited_by_id")
  token       String?   @map("token")
  tokenHash   String    @unique @map("token_hash")
  sentAt      DateTime  @default(now()) @map("sent_at")
  expiresAt   DateTime  @map("expires_at")
  clickedAt   DateTime? @map("clicked_at")
  acceptedAt  DateTime? @map("accepted_at")
  revokedAt   DateTime? @map("revoked_at")

  user      User @relation("UserInviteRecipient", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User @relation("UserInviteSender", fields: [invitedById], references: [id])

  @@index([userId, sentAt])
  @@map("user_invite")
}

// PLAN.md §15 — a post is an immutable snapshot of a Doc at one point in that
// doc's ydoc history, not an independently-edited document. `docId` is the doc
// it currently draws from (re-publishing may point it at a different one);
// `proseJson`/`title` are its own copy of that snapshot's content, so every
// public read is a column, not a join; `publishEventId` replaces
// `publishRevisionId` as the draft/published discriminator.
//
// `title` is deliberately its own column and not derived: a post's title may
// differ from the doc's title at snapshot time (it defaults to it).
model Post {
  id               String           @id @default(cuid())
  slug             String           @unique
  title            String
  docId            String           @map("doc_id")
  proseJson        Json?            @map("prose_json")
  publishEventId   String?          @unique @map("publish_event_id")
  moderationPolicy ModerationPolicy @default(INHERIT) @map("moderation_policy")
  createdAt        DateTime         @default(now()) @map("created_at")
  publishedAt      DateTime?        @map("published_at") // may be in the future — see below
  deletedByUserId  String?          @map("deleted_by_user_id")
  deletedAt        DateTime?        @map("deleted_at")

  // publishEventId is set immediately by both an immediate publish and a
  // *scheduled* one — visibility is gated by publishedAt vs now(), a pure
  // query-time condition (src/lib/post-status.ts's publishedPostWhere), not
  // a stored status or a background sweep that flips something at the
  // scheduled instant. See PLAN.md §4/§10/§15.
  doc                 Doc                    @relation(fields: [docId], references: [id])
  publishEvent        PostPublicationEvent?  @relation("PublishEvent", fields: [publishEventId], references: [id])
  authors             PostAuthor[]
  threads             CommentThread[]
  publicationEvents   PostPublicationEvent[] @relation("PostEvents")
  deletedBy           User?                  @relation("PostDeletedBy", fields: [deletedByUserId], references: [id])
  slugHistory         PostSlugHistory[]
  tagAnchors          TagAnchor[]            @relation("TagAnchorPost")
  anchoredLinkAnchors AnchoredLinkAnchor[]   @relation("AnchoredLinkAnchorPost")
  activity            PostActivity?
  metrics             PostMetrics?

  @@index([docId])
  @@map("post")
}

// The latest publication event per post, as a database view (PLAN.md §16e).
//
// Exists to make "Last edit by"/"Last edit at" sortable on /posts. Both are
// properties of the *most recent* row of a to-many relation, and Prisma can
// only order a to-many by `_count` — but it orders a to-one relation's
// columns freely, and a view keyed 1:1 on post_id is a to-one relation. The
// argmax (DISTINCT ON) happens in SQL, where it belongs; "Last edit by" isn't
// even an aggregate, so no amount of Prisma orderBy would have expressed it.
//
// Two things to know before touching it:
//   - Prisma Migrate does not manage views. `migrate diff` emits nothing for
//     this block, so the CREATE VIEW lives in a hand-written migration
//     (add_post_activity_view) the same way doc_length() does. Changing the
//     view means a new migration with CREATE OR REPLACE VIEW, not just an
//     edit here.
//   - The generated client will happily *type* writes to this model
//     (PostActivityCreateInput and friends). Postgres will reject them; the
//     view is read-only in fact, but nothing in TypeScript says so.
view PostActivity {
  // @unique, not @id: Prisma rejects a primary key on a view outright
  // ("Views cannot have primary keys").
  postId         String    @unique @map("post_id")
  lastEventAt    DateTime? @map("last_event_at")
  lastEditorName String?   @map("last_editor_name")

  post Post @relation(fields: [postId], references: [id])

  @@map("post_activity")
}

// Per-post aggregates, as a database view (PLAN.md §16e/§16l) — the byline
// and the comment counts /posts shows as "Author(s)" and "Comments".
//
// Same trick as PostActivity above and every caveat there applies verbatim
// (Migrate doesn't manage it; the client will type writes Postgres rejects).
// Kept separate from PostActivity deliberately: that one is an argmax over
// post_publication_event with a row only for posts that have events, this one
// is an aggregate with a row for every post. See add_post_metrics_view.
//
// Why these two couldn't be sorted before: both are derived from a to-many
// relation, and `orderBy` over a to-many offers only `_count`. A joined
// byline is not a count, and "approved comments, excluding soft-deleted ones"
// is a *filtered* count `_count` can't express either.
view PostMetrics {
  postId        String  @unique @map("post_id")
  // NULL for a post with no authors — sorted `nulls: "last"` so such a post
  // stays out of the way in both directions, and rendered as "" so the cell
  // reads exactly as it did when this was a JS join over the authors include.
  byline        String? @map("byline")
  approvedCount Int     @map("approved_count")
  pendingCount  Int     @map("pending_count")

  post Post @relation(fields: [postId], references: [id])

  @@map("post_metrics")
}

// Redirect sources for a post's past slugs — one row per slug the post has
// ever moved away from. [slug]/page.tsx falls back here on a live-slug miss
// so old links/bookmarks 301 to the post's current slug instead of 404ing.
// slug carries its own @unique (not @@unique([postId, slug])): a slug must
// be globally free to be claimed as *anyone's* current or historical slug —
// see slugInUse in src/lib/slug.ts.
model PostSlugHistory {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("post_slug_history")
}

// createdUserId/createdAt record who added this byline entry and when. A post's
// authors start as a copy of the source doc's doc_author rows but are edited
// independently from then on — a post author need not be a doc author, and vice
// versa. Deliberately no history: only the current set is stored, and changing
// the byline overwrites rather than appends. (§15 — the simplification is the
// point; a post_author_history table would be the first thing to add if the
// question "who was on this byline in March" ever gets asked.)
model PostAuthor {
  postId        String   @map("post_id")
  userId        String   @map("user_id")
  bylineOrder   Int      @map("byline_order")
  createdUserId String   @map("created_user_id")
  createdAt     DateTime @default(now()) @map("created_at")

  post        Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user        User @relation("PostAuthorUser", fields: [userId], references: [id], onDelete: Cascade)
  createdUser User @relation("PostAuthorCreatedBy", fields: [createdUserId], references: [id])

  @@id([postId, userId])
  @@map("post_author")
}

// Append-only audit log of publish/unpublish/schedule transitions, and — since
// §15 — the immutable per-version record that `Revision` used to be. A
// PUBLISHED/SCHEDULED row carries the whole published version: which doc it came
// from, which ydoc_snapshot pins that doc's state, and the title/proseJson
// derived from that snapshot. UNPUBLISHED/SCHEDULE_CANCELED rows carry none of
// those four (they retire a version rather than introducing one).
//
// ydocSnapshot is SetNull rather than Cascade: a snapshot is provenance, and an
// event that outlives its ydoc row still holds the content it published. Losing
// the pointer costs the ability to re-derive, not the version itself.
model PostPublicationEvent {
  id             String               @id @default(cuid())
  postId         String               @map("post_id")
  type           PublicationEventType
  docId          String?              @map("doc_id")
  ydocSnapshotId String?              @map("ydoc_snapshot_id")
  title          String?
  proseJson      Json?                @map("prose_json")
  scheduledFor   DateTime?            @map("scheduled_for") // only set for SCHEDULED events
  actorId        String?              @map("actor_id") // null = system
  createdAt      DateTime             @default(now()) @map("created_at")

  post                Post                 @relation("PostEvents", fields: [postId], references: [id], onDelete: Cascade)
  doc                 Doc?                 @relation(fields: [docId], references: [id], onDelete: SetNull)
  ydocSnapshot        YdocSnapshot?        @relation(fields: [ydocSnapshotId], references: [id], onDelete: SetNull)
  actor               User?                @relation("PublicationEventActor", fields: [actorId], references: [id])
  livePostOf          Post?                @relation("PublishEvent")
  threads             CommentThread[]
  // PLAN.md §20b — the post-side coordinate axis, and inert in PR 1: nothing
  // writes tag_anchor.anchored_event_id until POST_RANGE exists (§20i).
  // SetNull rather than Cascade, matching how every other pointer *into* this
  // log is treated: an event is provenance, and losing the pointer costs the
  // ability to re-derive, not the row that pointed at it.
  tagAnchors          TagAnchor[]          @relation("TagAnchorEvent")
  anchoredLinkAnchors AnchoredLinkAnchor[] @relation("AnchoredLinkAnchorEvent")

  @@index([postId, createdAt])
  @@map("post_publication_event")
}

model SiteSettings {
  id                      Int              @id @default(1)
  defaultModerationPolicy ModerationPolicy @default(ALWAYS) @map("default_moderation_policy")
  trustThreshold          Int              @default(3) @map("trust_threshold")
  defaultColumnOrder      Json?            @map("default_column_order")

  @@map("site_settings")
}

model Commenter {
  id            String  @id @default(cuid())
  userId        String? @unique @map("user_id")
  email         String  @unique
  displayName   String  @map("display_name")
  approvedCount Int     @default(0) @map("approved_count")
  forceModerate Boolean @default(false) @map("force_moderate")

  user     User?     @relation(fields: [userId], references: [id])
  comments Comment[]

  @@map("commenter")
}

model CommentThread {
  id              String       @id @default(cuid())
  postId          String       @map("post_id")
  anchoredEventId String       @map("anchored_event_id")
  anchorFrom      Int          @map("anchor_from")
  anchorTo        Int          @map("anchor_to")
  quotedText      String       @map("quoted_text")
  status          ThreadStatus @default(ACTIVE)
  createdAt       DateTime     @default(now()) @map("created_at")

  post     Post                 @relation(fields: [postId], references: [id], onDelete: Cascade)
  event    PostPublicationEvent @relation(fields: [anchoredEventId], references: [id])
  comments Comment[]

  // Postgres indexes a primary key but never the referencing side of a
  // foreign key. post_metrics' comment counts walk post → thread → comment,
  // so without this the display path rescans this table per post on the page
  // (add_comment_count_indexes).
  @@index([postId])
  @@map("comment_thread")
}

model Comment {
  id                String        @id @default(cuid())
  threadId          String        @map("thread_id")
  parentCommentId   String?       @map("parent_comment_id")
  commenterId       String        @map("commenter_id")
  body              Json
  status            CommentStatus @default(PENDING)
  ipAddress         String?       @map("ip_address")
  statusChangedById String?       @map("status_changed_by_id")
  statusChangedAt   DateTime?     @map("status_changed_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  editedAt          DateTime?     @map("edited_at")
  deletedByUserId   String?       @map("deleted_by_user_id")
  deletedAt         DateTime?     @map("deleted_at")

  thread          CommentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  parent          Comment?      @relation("CommentReplies", fields: [parentCommentId], references: [id])
  replies         Comment[]     @relation("CommentReplies")
  commenter       Commenter     @relation(fields: [commenterId], references: [id])
  statusChangedBy User?         @relation("CommentStatusChangedBy", fields: [statusChangedById], references: [id])
  deletedBy       User?         @relation("CommentDeletedBy", fields: [deletedByUserId], references: [id])

  // The other half of post_metrics' count path — see CommentThread.postId.
  @@index([threadId])
  @@map("comment")
}

// A living document — PLAN.md §12 — read as its current Yjs state (Doc ↔
// Ydoc joined only by id derivation, ydocIdForDoc/docIdFromYdocId in
// src/lib/ydoc-names.ts; deliberately no foreign key either way, since it's
// a function of docId and cannot drift). No moderationPolicy: annotations
// are never moderated. No publishRevisionId/publishedAt: a doc is never
// "published at a revision" — readers see the live doc. No doc_revision
// table yet either (§12m, held back pending review).
//
// title/proseJson are caches of the ydoc's "title"/"default" Yjs fragments,
// written by server/doc-cache.ts on the collab server's store debounce
// (§12d) — nullable because they're empty until the first store, i.e. for a
// doc that's been created but never edited.
model Doc {
  id                String        @id @default(cuid())
  slug              String        @unique
  title             String
  visibility        DocVisibility @default(PRIVATE)
  proseJson         Json?         @map("prose_json")
  // Character count of proseJson, maintained by the doc_sync_prose_json_length
  // trigger — never assign to it. A plain column rather than a GENERATED one
  // because Prisma reads a generated column's expression as a default and
  // would offer to strip it on every migrate (add_doc_prose_json_length), and
  // a stored column rather than a doc_metrics view column because a view
  // recomputes the recursive walk per query — for every doc in the table when
  // sorting by it, not just the page. @default(0) so
  // `doc.create()` needn't name it; the trigger overwrites it on INSERT
  // anyway.
  proseJsonLength   Int           @default(0) @map("prose_json_length")
  // PLAN.md §13q — which `ydoc_update` row `proseJson` above is the content
  // of, written by the same `updateDocCache` pass.
  //
  // What it buys is that the cache stops having *unknown* staleness. The rule
  // that `prose_json` is fine for deciding whether to draw something and
  // wrong for deciding where (CLAUDE.md, COLLAB.md's cross-cutting hazard) is
  // unchanged — a stamp does not make a stale cache fresh. But "how stale" is
  // now a value rather than a thing to remember, which is what lets
  // check-doc-integrity distinguish a legitimately-trailing cache from a
  // broken one instead of treating the difference as unfalsifiable.
  //
  // Distinct from `Annotation.ydocUpdateId`, which is an *anchor's* coordinate
  // system. This one describes a cached rendering; that one describes where a
  // quotation was measured. They are stamped from different logs for a reply
  // (§13p) and mean different things everywhere.
  proseJsonUpdateId BigInt?       @map("prose_json_update_id")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  // Updated when Prisma would update updatedAt. Sloppy with concurrent writes.
  updatedByUserId   String?       @map("updated_by_user_id")
  deletedByUserId   String?       @map("deleted_by_user_id")
  deletedAt         DateTime?     @map("deleted_at")

  authors             DocAuthor[]
  updatedBy           User?                  @relation("DocUpdatedBy", fields: [updatedByUserId], references: [id])
  deletedBy           User?                  @relation("DocDeletedBy", fields: [deletedByUserId], references: [id])
  slugHistory         DocSlugHistory[]
  annotations         Annotation[]
  docLinks            DocLink[]
  posts               Post[]
  publicationEvents   PostPublicationEvent[]
  metrics             DocMetrics?
  tagAnchors          TagAnchor[]            @relation("TagAnchorDoc")
  anchoredLinkAnchors AnchoredLinkAnchor[]   @relation("AnchoredLinkAnchorDoc")

  @@map("doc")
}

// /docs' Author(s) and Annotations columns, as a database view (PLAN.md
// §16e/§16l). Same caveats as PostMetrics; see add_doc_metrics_view and
// add_doc_annotation_count.
//
// Unlike PostMetrics neither branch of this view selects FROM doc, so it never
// references the base table. That is what keeps Prisma's LEFT JOIN back to doc
// from scanning it twice on every sort through the view — Postgres 18's
// self-join elimination only collapses INNER joins, so the second scan has to
// be removed rather than optimised away. /docs' third derived value, Length,
// would have forced this view to read doc; it is a stored column instead
// (Doc.proseJsonLength).
view DocMetrics {
  docId           String  @unique @map("doc_id")
  // NULL for a doc that has annotations but no authors — the FULL OUTER JOIN
  // gives such a doc a row where the old doc_author-only form gave it none
  // (add_doc_annotation_count). A doc with *neither* is still rowless, so the
  // relation stays the optional part too, and both cases render the same empty
  // cell and sort `nulls: "last"`.
  byline          String? @map("byline")
  // Live, non-DRAFT annotations on the doc, replies included — a *filtered*
  // count, which is why it is here rather than a Prisma `_count`: `_count` is
  // unconditional and cannot express either exclusion in an orderBy. COALESCEd
  // to 0 in the view and so declared non-null, matching FileMetrics, which
  // means orderBy takes a bare direction rather than the {sort, nulls} form.
  annotationCount Int     @map("annotation_count")

  doc Doc @relation(fields: [docId], references: [id])

  @@map("doc_metrics")
}

model DocAuthor {
  docId       String @map("doc_id")
  userId      String @map("user_id")
  bylineOrder Int    @map("byline_order")

  doc  Doc  @relation(fields: [docId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([docId, userId])
  @@map("doc_author")
}

// Redirect sources for a doc's past slugs — same shape/rationale as
// PostSlugHistory. slug carries its own @unique, not @@unique([docId, slug]):
// doc slugs are unique among docs only (a separate /doc/* namespace with no
// shared catch-all against post slugs), enforced by docSlugInUse in
// src/lib/doc-slug.ts rather than by this column against Post/PostSlugHistory.
model DocSlugHistory {
  id        String   @id @default(cuid())
  docId     String   @map("doc_id")
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  doc Doc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([docId])
  @@map("doc_slug_history")
}

// PLAN.md §12c/§12i — a root annotation (parentAnnotationId null) *is* the
// thread; replies hang off it through the same self-FK shape
// Comment.parentCommentId already uses. No moderation columns: annotations
// are never moderated (status below is about visibility/notification, §13d,
// not approval).
//
// PLAN.md §13o / COLLAB.md §7 — **two anchoring mechanisms, picked by the
// surface the annotation was written on, never by permission.** This used to
// say "no anchor columns" and mean it; the trio below is what changed.
//
//   - The doc *editor* anchors with a mark inside the doc's own ydoc
//     (src/lib/annotation-extension.ts, §12i) and leaves anchorFrom/anchorTo/
//     quotedText null. It can: it already holds a writable connection.
//   - Either *reading* view anchors with the trio and never writes a mark —
//     so annotating no longer mutates a document the annotator may not be
//     allowed to edit. See §13o for the security argument, which is the
//     reason the two differ.
//
// A row has one or the other, never both, and nothing reads "which" from a
// column: a null anchorFrom is exactly "look for a mark instead"
// (src/lib/annotation-anchors.ts resolves both into one map).
//
// PLAN.md §13 — the body itself is a live ydoc (ydocIdForAnnotation(id),
// src/lib/ydoc-names.ts), the same substrate a doc itself uses (§11).
// proseJson/bodyText are caches of that ydoc, written by
// server/annotation-cache.ts's store-debounce exactly the way Doc.proseJson/
// Doc.title already are (§12d) — losing them costs a rebuild, not data. The
// old plain-text `body` {text} column is gone: every row was backfilled onto
// proseJson/bodyText (scripts/backfill-annotation-ydocs.ts, since deleted)
// before this column was dropped.
// PLAN.md §19 — **an annotation hangs off a doc or off an uploaded file, never
// both and never neither.** Exactly one of docId/fileId is non-null, enforced
// by a hand-written CHECK in add_file_model's migration (Prisma has no CHECK
// DSL — same technique DocLink's mark_id/mark pair uses below). docId was NOT
// NULL until PDF annotations arrived; loosening it is a plain DROP NOT NULL
// with no backfill, since every pre-existing row keeps the doc it had.
//
// The two containers are genuinely different anchoring problems, not two
// spellings of one. A doc moves under its annotations, which is what the whole
// resolve-and-repair apparatus above exists for; a file's bytes cannot change
// (its sha256 is its identity), so a PDF anchor is measured once and is correct
// forever. That is why pdfTarget is a single opaque blob and needs none of
// anchorFrom/anchorTo's tracking machinery.
model Annotation {
  id                 String           @id @default(cuid())
  docId              String?          @map("doc_id")
  // PLAN.md §19 — the file counterpart of docId. Cascades for the same reason
  // docId does: an annotation on a deleted container is unreachable, not
  // merely orphaned.
  fileId             String?          @map("file_id")
  parentAnnotationId String?          @map("parent_annotation_id")
  userId             String           @map("user_id")
  proseJson          Json?            @map("prose_json")
  bodyText           String           @default("") @map("body_text")
  // PLAN.md §13q — the annotation-body counterpart of Doc.proseJsonUpdateId:
  // which update of *this annotation's own* ydoc the two columns above are
  // the content of, written by server/annotation-cache.ts's debounce.
  //
  // Inert while a posted annotation has no edit UI, since nothing moves after
  // the composer closes. It is here for the case where that changes
  // (docs/COLLAB.md's 2026-08-13 entry): a reply anchored into a body needs
  // that body's own rolling checkpoint for the same reason a doc annotation
  // needs the doc's, and building the seam now costs one column rather than a
  // migration under live data later.
  proseJsonUpdateId  BigInt?          @map("prose_json_update_id")
  status             AnnotationStatus @default(DRAFT)
  raisedAt           DateTime?        @map("raised_at")
  resolvedAt         DateTime?        @map("resolved_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  editedAt           DateTime?        @map("edited_at")
  deletedByUserId    String?          @map("deleted_by_user_id")
  deletedAt          DateTime?        @map("deleted_at")
  // PLAN.md §13o / COLLAB.md §7 — the reading-view anchor: offsets into the
  // document this annotation is *about*, plus the text that was there.
  //
  // **quotedText is derived server-side, never client-supplied**, and
  // derived against the document *at ydocUpdateId below*, not at whatever
  // the live state happens to be by the time the action runs. The client
  // sends its own reading of the selection; postAnnotation materializes the
  // stamped state, uses that string only to verify (and if need be correct)
  // the offsets against it, and stores its own textBetween at the resolved
  // range. Two things follow. §12i's "the selected text is a request field
  // only, never a column" stays true of the *trust* boundary even though
  // there is now a column — nothing a client says is stored verbatim. And
  // the triple is self-consistent forever: replay to ydocUpdateId and
  // textBetween(anchorFrom, anchorTo) *is* quotedText, by construction,
  // which is what makes COLLAB.md §7's materialize-and-diff repair
  // buildable later without trusting anything written today.
  //
  // Null/"" together means document-level, the same state a lost mark
  // degrades to. Resolution against the *live* doc at read time is a
  // separate, cheaper thing — a text-verify plus a unique-occurrence
  // fallback (src/lib/annotation-anchors.ts), doc-link shaped (COLLAB.md
  // §3) rather than post-comment shaped, because a doc has no immutable
  // snapshot for offsets to stay stable against.
  anchorFrom         Int?             @map("anchor_from")
  anchorTo           Int?             @map("anchor_to")
  quotedText         String           @default("") @map("quoted_text")
  // PLAN.md §12p/§13n/§13o — which ydoc_update the author's view showed when
  // they posted (postAnnotation, src/app/actions/annotations.ts): the
  // client's own scrub position when known precisely (annotating while
  // scrub-frozen), else the log's tail at post time. It drives "jump the
  // scrubber to roughly here," and it is the version stamp the offsets above
  // were measured against — comment_thread.anchored_event_id's analogue,
  // with the update log as the axis in place of discrete publication events.
  // Nothing resolves an anchor *through* it yet (§13o defers the
  // materialize-and-diff repair path); it is what makes that buildable.
  //
  // It names the log of whichever document the anchor is measured against —
  // the doc's for a root annotation, the *parent annotation's* own ydoc for
  // an anchored reply (§13p). An anchorless annotation stamps the doc's, as
  // every row did before anchored replies existed.
  //
  // No relation column on purpose: same plain-BigInt precedent as
  // YdocSnapshot.lastYdocUpdateId, and a FK into ydoc_update would need
  // ON DELETE SET NULL forever (the log is never truncated, but there's
  // nothing here worth a join for). Null for every row from before this
  // column existed, and for one whose fallback lookup came back empty (a
  // doc with no update log yet).
  ydocUpdateId       BigInt?          @map("ydoc_update_id")
  // PLAN.md §19 / docs/PDF.md §2 — the whole PDF anchor as one JSON blob:
  // { pageIndex, quads, quote: {exact,prefix,suffix}, position: {start,end},
  // textVersion }. Non-null exactly for a *root* annotation on a file; a reply
  // to one anchors into its parent's body with anchorFrom/anchorTo like any
  // other reply (§13p), so this stays null there.
  //
  // One opaque column rather than seven typed ones, for the reason docs/PDF.md
  // invariant 3 gives: the stored record must be renderer-neutral, so swapping
  // PDF.js for another engine is a rendering change and not a data migration.
  // Nothing in Postgres ever sorts or filters on a field inside it — the same
  // trade DocLink.mark already makes for the same kind of value.
  //
  // quote.exact is *also* written to quotedText above, which is what lets
  // /annotations render its Quote column with no PDF branch at all. That is a
  // deliberate duplication of one string, not a second source of truth: the
  // column is the display copy, this blob is the anchor.
  pdfTarget          Json?            @map("pdf_target")

  doc                 Doc?                 @relation(fields: [docId], references: [id], onDelete: Cascade)
  file                StoredFile?          @relation(fields: [fileId], references: [id], onDelete: Cascade)
  parent              Annotation?          @relation("AnnotationReplies", fields: [parentAnnotationId], references: [id])
  replies             Annotation[]         @relation("AnnotationReplies")
  user                User                 @relation("AnnotationAuthor", fields: [userId], references: [id])
  deletedBy           User?                @relation("AnnotationDeletedBy", fields: [deletedByUserId], references: [id])
  // PLAN.md §20b — anchors *pointing at* this annotation's body, not anchors
  // belonging to it. The annotation's own anchor columns stay where they are
  // until PR 2 moves them onto `annotation_anchor` (§20e).
  tagAnchors          TagAnchor[]          @relation("TagAnchorAnnotation")
  anchoredLinkAnchors AnchoredLinkAnchor[] @relation("AnchoredLinkAnchorAnnotation")

  @@index([docId])
  @@index([fileId])
  @@map("annotation")
}

// PLAN.md §14 — a doc link joins a selection in one doc to a selection in
// another. Deliberately the opposite of Annotation's comment above: a doc
// link's anchor lives *outside* the document, in `mark`, rather than as a
// mark embedded in the doc's own ydoc (§14a explains why — a mark lives in
// exactly one document, and a link joins two). That means it CAN fall out of
// sync with the document, and §14d is the resolution/repair policy that pays
// for it. `mark_id` is the inline-mark path (§14b) — a future alternative
// anchor using the same style of mark Annotation uses — reserved but unused;
// exactly one of `mark_id`/`mark` is ever non-null, enforced by a hand-added
// CHECK constraint in this model's migration (Prisma has no CHECK DSL).
//
// Soft delete is `deletedAt` alone here, not the deletedByUserId+deletedAt
// pair every other soft-deletable model in this file uses — a deliberate,
// singular divergence (§14b/§14n): neither this model nor DocLinkGroup joins
// the $extends soft-delete filter in src/lib/prisma.ts (that covers only
// post/user/doc; annotation is excluded too, on the same grounds, and
// filters by hand) so there is no UI depending on "who deleted this," and
// the single column avoids a second named @relation to User on both models.
model DocLink {
  id             String    @id @default(cuid())
  docId          String    @map("doc_id")
  markId         String?   @map("mark_id")
  mark           Json?
  text           String?
  docLinkGroupId String    @map("doc_link_group_id")
  overrideColor  String?   @map("override_color")
  userId         String    @map("user_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  doc   Doc          @relation(fields: [docId], references: [id], onDelete: Cascade)
  group DocLinkGroup @relation(fields: [docLinkGroupId], references: [id], onDelete: Cascade)
  user  User         @relation(fields: [userId], references: [id])

  @@index([docId])
  @@index([docLinkGroupId])
  @@map("doc_link")
}

// PLAN.md §14h/§14i — the named grouping a doc_link belongs to; the group,
// not the individual link, is what the group bar's dropdown lists and what a
// pulse targets across both columns at once (data-doc-link-group-ids). Not
// created until there is something to save (§14i) — an eagerly-created empty
// group would be invisible in its own dropdown, whose membership rule is
// "has a link to either doc." Deleting the last link does not delete the
// group; deleting the group soft-deletes its links, since docLinkGroupId is
// required and an orphaned link is meaningless.
model DocLinkGroup {
  id            String    @id @default(cuid())
  name          String?
  text          String?
  overrideColor String?   @map("override_color")
  userId        String    @map("user_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  user  User      @relation(fields: [userId], references: [id])
  links DocLink[]

  @@index([userId])
  @@map("doc_link_group")
}

// PLAN.md §19 — an uploaded file (a PDF today) that can be read and annotated
// at /pdf/[slug], sharing docs' PRIVATE/SHARED model and annotation stack.
//
// **Named StoredFile, mapped to `file`.** The table is `file`; the generated
// TypeScript type must not be `File`, which is a DOM/Node global the upload
// path uses in the same modules. A model name that shadows a global is a
// footgun that costs nothing to avoid, and `@@map` means the database never
// sees the workaround.
//
// **The bytes are not here.** They live on disk, content-addressed by sha256
// (src/lib/file-storage.ts, FILE_STORAGE_DIR). Prisma cannot stream a `Bytes`
// column, so a 50MB file would land whole in Node's heap on upload *and* on
// every one of PDF.js's range requests — the exact opposite of what the
// viewer needs. UserAvatar's in-Postgres bytes are not a precedent against
// this: those are ~10KB, served whole, and small enough that a blob column's
// costs never arrive. The consequence to remember is an operational one:
// FILE_STORAGE_DIR is a second backup surface that `pg_dump` does not cover
// (DEPLOY.md).
//
// **sha256 is the file's real identity** (docs/PDF.md §2's DocId), which is
// what makes the download URL immutable and what guarantees a PDF anchor can
// never drift: the bytes an annotation was measured against are, by
// construction, the bytes every later reader sees. Deliberately NOT unique —
// two people may upload the same paper under different titles, visibilities
// and bylines, and those are different documents socially even though the
// storage layer stores one copy.
model StoredFile {
  id          String        @id @default(cuid())
  slug        String        @unique
  // Shown everywhere a doc shows its title; seeded from the upload filename
  // and independently renamable afterwards.
  title       String
  // The name as uploaded, kept verbatim for the Content-Disposition on
  // download and so a renamed file still says where it came from.
  filename    String
  contentType String        @map("content_type")
  byteSize    Int           @map("byte_size")
  sha256      String
  // Null until the upload's server-side parse fills it in; also null for a
  // non-PDF, should other types ever be allowed.
  pageCount   Int?          @map("page_count")
  // Reuses docs' vocabulary rather than cloning it: PRIVATE/SHARED already
  // means one thing site-wide, and files' rule is specified as "the same as
  // docs'". The *predicates* over it are separate (canViewFiles /
  // canManageFiles, src/lib/role-checks.ts) so the two can diverge; the enum
  // is shared because a third visibility word would be a UI regression.
  visibility  DocVisibility @default(PRIVATE)

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  updatedByUserId String?   @map("updated_by_user_id")
  deletedByUserId String?   @map("deleted_by_user_id")
  deletedAt       DateTime? @map("deleted_at")

  owners              FileOwner[]
  slugHistory         FileSlugHistory[]
  pageTexts           FilePageText[]
  annotations         Annotation[]
  metrics             FileMetrics?
  tagAnchors          TagAnchor[]          @relation("TagAnchorFile")
  anchoredLinkAnchors AnchoredLinkAnchor[] @relation("AnchoredLinkAnchorFile")
  updatedBy           User?                @relation("FileUpdatedBy", fields: [updatedByUserId], references: [id])
  deletedBy           User?                @relation("FileDeletedBy", fields: [deletedByUserId], references: [id])

  @@index([sha256])
  @@map("file")
}

// /files' Owner(s) and Annotations columns, as a view — the same role
// DocMetrics plays for /docs, and built the same way for the same reason:
// by grouping file_owner, never by selecting FROM file. A view that reads
// its own base table gets scanned twice on every sort through it, because
// Prisma emits a LEFT JOIN for a to-one relation ordering and Postgres 18's
// self-join elimination only collapses INNER joins (add_doc_metrics_view,
// PLAN.md §16l).
//
// annotationCount is here rather than as a Prisma `_count` because it is a
// *filtered* count — soft-deleted annotations don't count — and `_count` has
// no way to express that in an orderBy. Size and Pages are plain stored
// columns on file and need neither this view nor a trigger: unlike Doc's
// Length they are known at upload time and never recomputed.
view FileMetrics {
  fileId          String  @unique @map("file_id")
  owners          String? @map("owners")
  annotationCount Int     @map("annotation_count")

  file StoredFile @relation(fields: [fileId], references: [id])

  @@map("file_metrics")
}

// Who a file belongs to (PLAN.md §19). Deliberately *not* called an author:
// the people listed here didn't write the PDF, they hold it — the list is
// seeded with whoever uploaded it and edited freely afterwards, and what it
// confers is the byline-shaped display in /files' Owner(s) column, the right
// to rename/re-slug/re-own/delete, and, for a PRIVATE file, the right to read
// it at all (src/lib/file-authz.ts). DocAuthor/PostAuthor keep their name
// because a doc's or post's listed users really did write it.
model FileOwner {
  fileId     String @map("file_id")
  userId     String @map("user_id")
  ownerOrder Int    @map("owner_order")

  file StoredFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([fileId, userId])
  @@map("file_owner")
}

// Redirect sources for a file's past slugs — same shape and rationale as
// DocSlugHistory. Its own uniqueness namespace: a file, a doc and a post may
// all share a slug and resolve to three different URLs, since /pdf/*, /doc/*
// and the post catch-all never collide.
model FileSlugHistory {
  id        String   @id @default(cuid())
  fileId    String   @map("file_id")
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  file StoredFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@map("file_slug_history")
}

// PLAN.md §19 / docs/PDF.md §3 — the normalised text of one page, extracted
// once at upload and stored rather than recomputed. This settles docs/PDF.md
// §12's first open question, and it earns its keep twice:
//
//  1. It is what lets postAnnotation derive `quotedText` **server-side** for a
//     PDF, by slicing this at the client's reported offsets and storing its own
//     slice. Without it, honouring §12i's "the selected text is a request field
//     only, never a column" would mean re-parsing the PDF on every post.
//  2. It is the only thing scripts/integrity/check-pdf-anchors.ts can check a
//     stored quote against, since there is no ydoc to replay for a file.
//
// textVersion is part of the key, not a column to overwrite: it names the
// extractor+normaliser that produced this text (`${pdfjsVersion}/${n}`), and a
// bump means the *old* rows stay valid for annotations already measured
// against them while new ones are written alongside. Re-anchoring across a
// bump is lazy and per-annotation (docs/PDF.md §3), which is only possible if
// both generations are still on disk.
model FilePageText {
  fileId      String @map("file_id")
  pageIndex   Int    @map("page_index")
  textVersion String @map("text_version")
  text        String

  file StoredFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([fileId, pageIndex, textVersion])
  @@map("file_page_text")
}

// PLAN.md §20c — a term in the site's vocabulary.
//
// Deliberately *not* a row in one W3C-style annotation supertable with a
// motivation column (§20a's first rejected shape): `Annotation` carries a live
// ydoc body, caches, an `AnnotationStatus` lifecycle and a raise/notify flow,
// and a tag assignment has none of those. Folding them together would be
// the false unification this schema keeps warning about, and every consumer
// would pay a branch on `motivation` forever.
//
// Soft-deletes with the ordinary deletedByUserId+deletedAt pair, and **joins
// the $extends filter** in src/lib/prisma.ts — it has an admin table
// (`/tags`) that needs `prismaIncludingDeleted` to offer restore, exactly
// as `storedFile` does. Its assignments deliberately do not; see below.
//
// Uniqueness is on two columns, only one of which Prisma can express: `slug`
// carries @unique here, and a hand-written `CREATE UNIQUE INDEX … ON tag
// (lower(name))` lives in the migration. Slug uniqueness alone would admit
// "Epistemology" and "epistemology" as distinct terms, which is a vocabulary
// bug rather than a display one.
//
// Slugs are their own namespace (`/tag/*`), like docs' and files' —
// `tagSlugInUse` checks `tag` only. **No slug history table in v1**: a
// renamed tag breaks inbound `/tag/…` links until it earns one (§20i).
model Tag {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?

  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  deletedByUserId String?   @map("deleted_by_user_id")
  deletedAt       DateTime? @map("deleted_at")

  createdBy   User            @relation("TagCreatedBy", fields: [createdById], references: [id])
  deletedBy   User?           @relation("TagDeletedBy", fields: [deletedByUserId], references: [id])
  assignments TagAssignment[]
  metrics     TagMetrics?

  @@index([createdById])
  @@map("tag")
}

// PLAN.md §20c — **one act of tagging**, the `doc_link_group` analogue.
//
// It owns 1..n anchors and carries who tagged and when. Tagging a whole doc is
// one assignment with one selector-less anchor; PR 2's part-tagging adds
// anchors, not concepts. That is the whole reason this row exists rather than
// the tag pointing at objects directly: one act that spans three passages
// is one record, undone as one.
//
// **Does not join the $extends soft-delete filter** in src/lib/prisma.ts, and
// filters `deletedAt` by hand instead. Stated here so the divergence reads as
// chosen rather than missed (the §14b convention): that filter intercepts
// top-level operations only, and an assignment is read almost exclusively
// through a `tag_anchor` include, which it cannot reach. A model that
// joined the filter and was then read nested would look protected and not be.
model TagAssignment {
  id        String   @id @default(cuid())
  tagId     String   @map("tag_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  deletedByUserId String?   @map("deleted_by_user_id")
  deletedAt       DateTime? @map("deleted_at")

  tag       Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)
  user      User        @relation("TagAssignedBy", fields: [userId], references: [id])
  deletedBy User?       @relation("TagAssignmentDeletedBy", fields: [deletedByUserId], references: [id])
  anchors   TagAnchor[]

  @@index([tagId])
  @@index([userId])
  @@map("tag_assignment")
}

// PLAN.md §20b — one targeted part of one act of tagging, and the canonical
// statement of **the anchor row shape**. `AnnotationAnchor` (PR 2, §20e)
// repeats it verbatim below its own owner FK.
//
// **The object side is an exclusive arc of four nullable FKs**, exactly one
// non-null, enforced by a hand-written `CHECK (num_nonnulls(…) = 1)` in the
// migration (Prisma has no CHECK DSL — the `doc_link` and `add_file_model`
// convention). Real FKs rather than a `(type, id)` pair because this schema
// leans hard on cascades: deleting a doc must take every anchor pointing at
// it. The cost, accepted with eyes open, is that **a new targetable kind is a
// migration** — one column, one index, one CHECK edit, per anchor table.
// §20i names the signals that would justify the supertype pivot instead, and
// why not now. src/lib/anchors/target.ts is this arc's TypeScript face.
//
// **A tag part-anchor uses the column mechanism on every surface,
// including the doc editor.** That is a deliberate, recorded deviation from
// §13o's "an annotation's mechanism follows the surface" — read `annotation`'s
// comment above, which describes the opposite rule, and §14a for why the two
// comments sit next to each other saying different things. A tag mark
// would add a second mark type to the collaborative doc grammar, a second
// `excludes: ""` growth path and a second decoration-splitting layer, for
// ranges lighter-weight than discussion threads. The zero-rows convention
// keeps the door open if editor-applied tag ranges ever prove to need
// mark-grade drift immunity (§20f).
//
// **Anchors have no soft delete of their own.** Removing one part of a
// multi-part act deletes that row; removing the act soft-deletes the
// assignment. An anchor is a part of a record, not a record.
model TagAnchor {
  id           String @id @default(cuid())
  assignmentId String @map("assignment_id")

  // The object arc — exactly one non-null.
  docId              String? @map("doc_id")
  postId             String? @map("post_id")
  fileId             String? @map("file_id")
  targetAnnotationId String? @map("target_annotation_id")

  // The part selector — **all null means the whole object**, which is every
  // row PR 1 writes. A second hand-written CHECK keeps them null *together*:
  //   (selector_kind IS NULL) = (anchor_from IS NULL AND anchor_to IS NULL AND selector IS NULL)
  // — which is what makes shipping these columns before their writer honest,
  // the way §14b's num_nonnulls(mark_id, mark) made `mark_id` honest. The
  // CHECK is permanent either way.
  //
  // `quoted_text` is **derived server-side against the state the stamp names**,
  // never stored as the client sent it (§13o's trust rule). Replay the target
  // to `ydoc_update_id` and textBetween(anchor_from, anchor_to) *is*
  // `quoted_text`, by construction — which is what lets one integrity checker
  // cover every anchor row in the system (§20g).
  //
  // `selector` is opaque jsonb — PDF quads/quote/position/textVersion,
  // before/after context, blocks, `v` — the same trade `pdf_target` and
  // `doc_link.mark` already make. Nothing in Postgres sorts or filters inside
  // it, so no GIN index. Every read goes through `parseSelector`
  // (src/lib/anchors/selector.ts), never a cast.
  selectorKind SelectorKind? @map("selector_kind")
  anchorFrom   Int?          @map("anchor_from")
  anchorTo     Int?          @map("anchor_to")
  quotedText   String        @default("") @map("quoted_text")
  selector     Json?

  // The coordinate system the offsets are expressed in.
  //
  // `ydoc_update_id` **names the log of this row's own target**: a row
  // targeting a doc stamps the doc's log, a row targeting an annotation body
  // stamps that annotation's log. This is §13p's overload dissolved — the
  // stamp and the target live on the same row, so they cannot be chosen
  // independently. No relation column, same plain-BigInt precedent as
  // `Annotation.ydocUpdateId` and `YdocSnapshot.lastYdocUpdateId`.
  //
  // `anchored_event_id` is the **post-side** axis — publication events, not
  // ydoc updates (§5). It ships inert: nullable, no writer, on the §13p
  // `proseJsonUpdateId` precedent, because building the seam costs one column
  // now rather than a migration under live data later. `POST_RANGE` is
  // deferred with it (§20i).
  ydocUpdateId    BigInt? @map("ydoc_update_id")
  anchoredEventId String? @map("anchored_event_id")

  /// Position within a multi-part act. Every PR 1 row is 0.
  partOrder Int @default(0) @map("part_order")

  assignment       TagAssignment         @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  doc              Doc?                  @relation("TagAnchorDoc", fields: [docId], references: [id], onDelete: Cascade)
  post             Post?                 @relation("TagAnchorPost", fields: [postId], references: [id], onDelete: Cascade)
  file             StoredFile?           @relation("TagAnchorFile", fields: [fileId], references: [id], onDelete: Cascade)
  targetAnnotation Annotation?           @relation("TagAnchorAnnotation", fields: [targetAnnotationId], references: [id], onDelete: Cascade)
  anchoredEvent    PostPublicationEvent? @relation("TagAnchorEvent", fields: [anchoredEventId], references: [id], onDelete: SetNull)

  @@index([assignmentId])
  @@index([docId])
  @@index([postId])
  @@index([fileId])
  @@index([targetAnnotationId])
  @@map("tag_anchor")
}

// PLAN.md §20d — `/tags`' derived columns, as a view keyed 1:1 on
// tag.id, so Prisma sees a to-one relation and every column sorts in
// Postgres rather than in JS (§16e).
//
// **Built by grouping tag_assignment/tag_anchor, never `FROM
// tag`** — doc_metrics' double-scan lesson (§16l): a view that reads its
// own base table gets that table scanned twice on every sort through it,
// because Prisma emits a LEFT JOIN for a to-one relation ordering and
// Postgres 18's self-join elimination only collapses INNER joins.
//
// The cost is the same harmless semantic difference doc_metrics carries: a
// tag nobody has used has **no row here at all**, so the relation is the
// optional part. The page reads `tag.metrics?.x ?? 0` and sorts with the
// relation ordered `nulls: "last"`.
//
// Every aggregate here is cheap (`count(*) FILTER`, `max`), so nothing needs
// the trigger-maintained-column treatment `Doc.proseJsonLength` gets — the
// §16l view-vs-column rule decides that, not taste, and it decides "view"
// until sorting by usage measures badly at real scale.
view TagMetrics {
  tagId           String    @unique @map("tag_id")
  // **Every count is nullable, and that is load-bearing rather than pedantic.**
  // A view's columns carry no NOT NULL (DocMetrics says the same), but the
  // NULLs that actually arrive here come from the LEFT JOIN rather than from
  // the view: a tag nobody has used has no row at all, so Prisma's join
  // back to it yields NULLs in every column. Declared non-null, Prisma rejects
  // the `{ sort, nulls }` orderBy form — and plain `DESC` puts those NULLs
  // *first* in Postgres, so sorting /tags by most-used would lead with the
  // terms nobody has ever applied. Nullable is what lets the page say
  // `nulls: "last"` and mean it. (file_metrics is declared the other way and
  // gets away with it only because every file has an owner, so its FULL OUTER
  // JOIN always emits a row.)
  assignmentCount Int?      @map("assignment_count")
  docCount        Int?      @map("doc_count")
  postCount       Int?      @map("post_count")
  fileCount       Int?      @map("file_count")
  annotationCount Int?      @map("annotation_count")
  lastUsedAt      DateTime? @map("last_used_at")

  tag Tag @relation(fields: [tagId], references: [id])

  @@map("tag_metrics")
}

// docs/ANCHORED_LINKS.md — **one shareable URL over 1..n text selections**
// across docs and PDFs. The `TagAssignment` analogue on the §20a envelope:
// one act owning anchor rows ordered by `part_order`, soft-deleted as one.
// The row's cuid *is* the URL id (`?sel=<id>`); no separate token column.
//
// `minted_at` null means **the creator's open draft** — the tray's working
// set, visible to no one else. A partial unique index in the migration
// (`anchored_link_one_draft_per_user`: one row per creator with
// `minted_at IS NULL AND deleted_at IS NULL`) is what makes
// `loadMyDraftLink` a definite article and the get-or-create race a
// catchable P2002. Prisma has no partial-index DSL, so it lives in SQL only.
//
// Like `TagAssignment`, deliberately **not** in the $extends soft-delete
// filter (read through anchor includes, which the filter cannot reach);
// `deletedAt` is filtered by hand.
model AnchoredLink {
  id          String   @id @default(cuid())
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  /// Null = the creator's open draft; set once, when the URL is handed out.
  mintedAt DateTime? @map("minted_at")

  deletedByUserId String?   @map("deleted_by_user_id")
  deletedAt       DateTime? @map("deleted_at")

  createdBy User                 @relation("AnchoredLinkCreatedBy", fields: [createdById], references: [id])
  deletedBy User?                @relation("AnchoredLinkDeletedBy", fields: [deletedByUserId], references: [id])
  anchors   AnchoredLinkAnchor[]

  @@index([createdById])
  @@map("anchored_link")
}

// The §20b anchor row shape, verbatim from `TagAnchor` above under a new
// owner FK — read that model's comments for the arc, the CHECKs, the trust
// rule on `quoted_text`, and the stamp semantics; none of it differs here.
// Same two hand-written CHECKs in the migration (exactly-one-target,
// selector-columns-null-together). Hard-delete only, like every anchor row:
// a part is a part of a record, not a record.
//
// The v1 writer produces only `doc_id` + DOC_RANGE and `file_id` + PDF_TEXT
// rows; `post_id`/`target_annotation_id`/`anchored_event_id` ship inert on
// the same one-column-now-vs-migration-later reasoning as `TagAnchor`'s.
model AnchoredLinkAnchor {
  id     String @id @default(cuid())
  linkId String @map("link_id")

  // The object arc — exactly one non-null (CHECK in the migration).
  docId              String? @map("doc_id")
  postId             String? @map("post_id")
  fileId             String? @map("file_id")
  targetAnnotationId String? @map("target_annotation_id")

  selectorKind SelectorKind? @map("selector_kind")
  anchorFrom   Int?          @map("anchor_from")
  anchorTo     Int?          @map("anchor_to")
  quotedText   String        @default("") @map("quoted_text")
  selector     Json?

  ydocUpdateId    BigInt? @map("ydoc_update_id")
  anchoredEventId String? @map("anchored_event_id")

  /// Position within the link. Assigned as current-count at add time and
  /// never renumbered on removal; readers order by [partOrder, id].
  partOrder Int @default(0) @map("part_order")

  link             AnchoredLink          @relation(fields: [linkId], references: [id], onDelete: Cascade)
  doc              Doc?                  @relation("AnchoredLinkAnchorDoc", fields: [docId], references: [id], onDelete: Cascade)
  post             Post?                 @relation("AnchoredLinkAnchorPost", fields: [postId], references: [id], onDelete: Cascade)
  file             StoredFile?           @relation("AnchoredLinkAnchorFile", fields: [fileId], references: [id], onDelete: Cascade)
  targetAnnotation Annotation?           @relation("AnchoredLinkAnchorAnnotation", fields: [targetAnnotationId], references: [id], onDelete: Cascade)
  anchoredEvent    PostPublicationEvent? @relation("AnchoredLinkAnchorEvent", fields: [anchoredEventId], references: [id], onDelete: SetNull)

  @@index([linkId])
  @@index([docId])
  @@index([postId])
  @@index([fileId])
  @@index([targetAnnotationId])
  @@map("anchored_link_anchor")
}

// A generic, standalone Yjs document store — PLAN.md §11. Keyed purely by the
// Hocuspocus documentName (a `ydoc:`-prefixed id when routed through
// server/ydoc-hooks.ts, see src/lib/ydoc-names.ts); no relation to Post or
// anything else. `ydoc` is the O(1) cold-open path (Y.encodeStateAsUpdate);
// `ydocUpdate` is the never-truncated-on-save raw update log, whose first row
// per document is always a full state and every later row a plain delta
// (invariant 1, PLAN.md §11b); `ydocSnapshot` is a checkpoint constructed
// on demand, never implicitly, that lets a truncation-aware reader resolve a
// replay base without walking the log from row 1 (invariant 2).
model Ydoc {
  id           String   @id
  ydoc         Bytes
  stateVector  Bytes    @map("state_vector")
  // PLAN.md §13q — which `ydoc_update` row the two columns above correspond
  // to, written in the same store-debounce pass that writes them.
  //
  // This makes the row a **rolling checkpoint**: a base that is never more
  // than one debounce behind head, which is what
  // `resolveUpdateIdForSnapshot` walks forward from. Without it that walk
  // starts at the newest `ydoc_snapshot` covered by the client — and
  // snapshots are created deliberately, never implicitly (§11b), so a doc
  // that has never been published has none and the walk covers its whole
  // lifetime. Measured before this existed: 1219 rows on a real document.
  //
  // Null until the first debounce after this column landed. Deliberately not
  // backfilled: the honest value for an existing row is "unknown", and a
  // guessed one would be indistinguishable from a real one while sending the
  // walk to the wrong place.
  lastUpdateId BigInt?  @map("last_update_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  updates   YdocUpdate[]
  snapshots YdocSnapshot[]

  @@index([updatedAt])
  @@map("ydoc")
}

model YdocUpdate {
  id        BigInt   @id @default(autoincrement())
  ydocId    String   @map("ydoc_id")
  update    Bytes
  createdAt DateTime @default(now()) @map("created_at")

  doc Ydoc @relation(fields: [ydocId], references: [id], onDelete: Cascade)

  @@index([ydocId, id])
  @@map("ydoc_update")
}

model YdocSnapshot {
  id               String   @id @default(cuid())
  ydocId           String   @map("ydoc_id")
  ydoc             Bytes
  stateVector      Bytes    @map("state_vector")
  lastYdocUpdateId BigInt   @map("last_ydoc_update_id")
  userId           String?  @map("user_id")
  createdAt        DateTime @default(now()) @map("created_at")

  doc               Ydoc                   @relation(fields: [ydocId], references: [id], onDelete: Cascade)
  user              User?                  @relation("YdocSnapshotUser", fields: [userId], references: [id])
  publicationEvents PostPublicationEvent[]

  @@index([ydocId, lastYdocUpdateId])
  @@map("ydoc_snapshot")
}
