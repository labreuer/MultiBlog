// Prisma schema for MultiBlog — see PLAN.md §4 for the data model rationale.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // `views` is still a preview feature in Prisma 7.9 — it's what makes the
  // `view` block below generate a model at all. See PostActivity for why a
  // view earns its keep here.
  previewFeatures = ["views"]
}

// No `url` here: Prisma 7 rejects it in the schema (P1012). The CLI reads the
// connection string from prisma.config.ts's `datasource` block, and the
// runtime gets it via the PrismaPg adapter in src/lib/prisma.ts.
datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EDITOR
  AUTHOR
  AUTHORIZED
  COMMENTER

  @@map("role")
}

enum ModerationPolicy {
  INHERIT
  ALWAYS
  AUTO

  @@map("moderation_policy")
}

enum PublicationEventType {
  PUBLISHED
  UNPUBLISHED
  SCHEDULED
  SCHEDULE_CANCELED

  @@map("publication_event_type")
}

enum ThreadStatus {
  ACTIVE
  DETACHED
  RESOLVED

  @@map("thread_status")
}

enum CommentStatus {
  PENDING
  APPROVED
  SPAM
  DELETED

  @@map("comment_status")
}

// PLAN.md §12e — PRIVATE is byline authors plus ADMIN/EDITOR; SHARED is
// anyone with canViewDocs. No "unlisted" tier: with role gating underneath,
// it would have no threat model left to address.
enum DocVisibility {
  PRIVATE
  SHARED

  @@map("doc_visibility")
}

// PLAN.md §13d — an annotation's visibility/notification axis, orthogonal to
// moderation (annotations are never moderated, §12c). DRAFT never carries an
// inline mark and notifies nobody; LIVE is the ordinary posted state; RAISED
// is LIVE plus the doc's byline authors have been emailed.
enum AnnotationStatus {
  DRAFT
  LIVE
  RAISED

  @@map("annotation_status")
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  slug             String           @unique
  emailVerified    DateTime?        @map("email_verified")
  name             String?
  image            String?
  passwordHash     String?          @map("password_hash")
  role             Role             @default(COMMENTER)
  moderationPolicy ModerationPolicy @default(INHERIT) @map("moderation_policy")
  color            String           @default("#5b8cff")
  adminInitials    String           @map("admin_initials")
  rowsPerPage      Int              @default(25) @map("rows_per_page")
  columnOrder      Json?            @map("column_order")
  createdAt        DateTime         @default(now()) @map("created_at")
  deletedByUserId  String?          @map("deleted_by_user_id")
  deletedAt        DateTime?        @map("deleted_at")

  accounts             Account[]
  sessions             Session[]
  postAuthors          PostAuthor[]           @relation("PostAuthorUser")
  postAuthorGrants     PostAuthor[]           @relation("PostAuthorCreatedBy")
  commenter            Commenter?
  passwordResetTokens  PasswordResetToken[]
  commentStatusChanges Comment[]              @relation("CommentStatusChangedBy")
  commentDeletions     Comment[]              @relation("CommentDeletedBy")
  publicationEvents    PostPublicationEvent[] @relation("PublicationEventActor")
  deletedBy            User?                  @relation("UserDeletedBy", fields: [deletedByUserId], references: [id])
  deletedUsers         User[]                 @relation("UserDeletedBy")
  postDeletions        Post[]                 @relation("PostDeletedBy")
  slugHistory          UserSlugHistory[]
  ydocSnapshots        YdocSnapshot[]         @relation("YdocSnapshotUser")
  docAuthors           DocAuthor[]
  docDeletions         Doc[]                  @relation("DocDeletedBy")
  annotations          Annotation[]           @relation("AnnotationAuthor")
  annotationDeletions  Annotation[]           @relation("AnnotationDeletedBy")
  docLinks             DocLink[]
  docLinkGroups        DocLinkGroup[]

  @@map("user")
}

// Redirect sources for a user's past slugs — same shape as PostSlugHistory,
// kept as its own table rather than a shared polymorphic one since Prisma
// has no real polymorphic relation support (see PostSlugHistory's comment).
model UserSlugHistory {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_slug_history")
}

// Auth.js (NextAuth) Prisma adapter models — used for OAuth account linking.
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("account")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_token")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_token")
}

// PLAN.md §15 — a post is an immutable snapshot of a Doc at one point in that
// doc's ydoc history, not an independently-edited document. `docId` is the doc
// it currently draws from (re-publishing may point it at a different one);
// `proseJson`/`title` are its own copy of that snapshot's content, so every
// public read is a column, not a join; `publishEventId` replaces
// `publishRevisionId` as the draft/published discriminator.
//
// `title` is deliberately its own column and not derived: a post's title may
// differ from the doc's title at snapshot time (it defaults to it).
model Post {
  id               String           @id @default(cuid())
  slug             String           @unique
  title            String
  docId            String           @map("doc_id")
  proseJson        Json?            @map("prose_json")
  publishEventId   String?          @unique @map("publish_event_id")
  moderationPolicy ModerationPolicy @default(INHERIT) @map("moderation_policy")
  createdAt        DateTime         @default(now()) @map("created_at")
  publishedAt      DateTime?        @map("published_at") // may be in the future — see below
  deletedByUserId  String?          @map("deleted_by_user_id")
  deletedAt        DateTime?        @map("deleted_at")

  // publishEventId is set immediately by both an immediate publish and a
  // *scheduled* one — visibility is gated by publishedAt vs now(), a pure
  // query-time condition (src/lib/post-status.ts's publishedPostWhere), not
  // a stored status or a background sweep that flips something at the
  // scheduled instant. See PLAN.md §4/§10/§15.
  doc               Doc                    @relation(fields: [docId], references: [id])
  publishEvent      PostPublicationEvent?  @relation("PublishEvent", fields: [publishEventId], references: [id])
  authors           PostAuthor[]
  threads           CommentThread[]
  publicationEvents PostPublicationEvent[] @relation("PostEvents")
  deletedBy         User?                  @relation("PostDeletedBy", fields: [deletedByUserId], references: [id])
  slugHistory       PostSlugHistory[]
  activity          PostActivity?
  metrics           PostMetrics?

  @@index([docId])
  @@map("post")
}

// The latest publication event per post, as a database view (PLAN.md §16e).
//
// Exists to make "Last edit by"/"Last edit at" sortable on /posts. Both are
// properties of the *most recent* row of a to-many relation, and Prisma can
// only order a to-many by `_count` — but it orders a to-one relation's
// columns freely, and a view keyed 1:1 on post_id is a to-one relation. The
// argmax (DISTINCT ON) happens in SQL, where it belongs; "Last edit by" isn't
// even an aggregate, so no amount of Prisma orderBy would have expressed it.
//
// Two things to know before touching it:
//   - Prisma Migrate does not manage views. `migrate diff` emits nothing for
//     this block, so the CREATE VIEW lives in a hand-written migration
//     (add_post_activity_view) the same way doc_length() does. Changing the
//     view means a new migration with CREATE OR REPLACE VIEW, not just an
//     edit here.
//   - The generated client will happily *type* writes to this model
//     (PostActivityCreateInput and friends). Postgres will reject them; the
//     view is read-only in fact, but nothing in TypeScript says so.
view PostActivity {
  // @unique, not @id: Prisma rejects a primary key on a view outright
  // ("Views cannot have primary keys").
  postId         String    @unique @map("post_id")
  lastEventAt    DateTime? @map("last_event_at")
  lastEditorName String?   @map("last_editor_name")

  post Post @relation(fields: [postId], references: [id])

  @@map("post_activity")
}

// Per-post aggregates, as a database view (PLAN.md §16e/§16l) — the byline
// and the comment counts /posts shows as "Author(s)" and "Comments".
//
// Same trick as PostActivity above and every caveat there applies verbatim
// (Migrate doesn't manage it; the client will type writes Postgres rejects).
// Kept separate from PostActivity deliberately: that one is an argmax over
// post_publication_event with a row only for posts that have events, this one
// is an aggregate with a row for every post. See add_post_metrics_view.
//
// Why these two couldn't be sorted before: both are derived from a to-many
// relation, and `orderBy` over a to-many offers only `_count`. A joined
// byline is not a count, and "approved comments, excluding soft-deleted ones"
// is a *filtered* count `_count` can't express either.
view PostMetrics {
  postId String @unique @map("post_id")
  // NULL for a post with no authors — sorted `nulls: "last"` so such a post
  // stays out of the way in both directions, and rendered as "" so the cell
  // reads exactly as it did when this was a JS join over the authors include.
  byline        String? @map("byline")
  approvedCount Int     @map("approved_count")
  pendingCount  Int     @map("pending_count")

  post Post @relation(fields: [postId], references: [id])

  @@map("post_metrics")
}

// Redirect sources for a post's past slugs — one row per slug the post has
// ever moved away from. [slug]/page.tsx falls back here on a live-slug miss
// so old links/bookmarks 301 to the post's current slug instead of 404ing.
// slug carries its own @unique (not @@unique([postId, slug])): a slug must
// be globally free to be claimed as *anyone's* current or historical slug —
// see slugInUse in src/lib/slug.ts.
model PostSlugHistory {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("post_slug_history")
}

// createdUserId/createdAt record who added this byline entry and when. A post's
// authors start as a copy of the source doc's doc_author rows but are edited
// independently from then on — a post author need not be a doc author, and vice
// versa. Deliberately no history: only the current set is stored, and changing
// the byline overwrites rather than appends. (§15 — the simplification is the
// point; a post_author_history table would be the first thing to add if the
// question "who was on this byline in March" ever gets asked.)
model PostAuthor {
  postId        String   @map("post_id")
  userId        String   @map("user_id")
  bylineOrder   Int      @map("byline_order")
  createdUserId String   @map("created_user_id")
  createdAt     DateTime @default(now()) @map("created_at")

  post        Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user        User @relation("PostAuthorUser", fields: [userId], references: [id], onDelete: Cascade)
  createdUser User @relation("PostAuthorCreatedBy", fields: [createdUserId], references: [id])

  @@id([postId, userId])
  @@map("post_author")
}

// Append-only audit log of publish/unpublish/schedule transitions, and — since
// §15 — the immutable per-version record that `Revision` used to be. A
// PUBLISHED/SCHEDULED row carries the whole published version: which doc it came
// from, which ydoc_snapshot pins that doc's state, and the title/proseJson
// derived from that snapshot. UNPUBLISHED/SCHEDULE_CANCELED rows carry none of
// those four (they retire a version rather than introducing one).
//
// ydocSnapshot is SetNull rather than Cascade: a snapshot is provenance, and an
// event that outlives its ydoc row still holds the content it published. Losing
// the pointer costs the ability to re-derive, not the version itself.
model PostPublicationEvent {
  id             String               @id @default(cuid())
  postId         String               @map("post_id")
  type           PublicationEventType
  docId          String?              @map("doc_id")
  ydocSnapshotId String?              @map("ydoc_snapshot_id")
  title          String?
  proseJson      Json?                @map("prose_json")
  scheduledFor   DateTime?            @map("scheduled_for") // only set for SCHEDULED events
  actorId        String?              @map("actor_id") // null = system
  createdAt      DateTime             @default(now()) @map("created_at")

  post         Post            @relation("PostEvents", fields: [postId], references: [id], onDelete: Cascade)
  doc          Doc?            @relation(fields: [docId], references: [id], onDelete: SetNull)
  ydocSnapshot YdocSnapshot?   @relation(fields: [ydocSnapshotId], references: [id], onDelete: SetNull)
  actor        User?           @relation("PublicationEventActor", fields: [actorId], references: [id])
  livePostOf   Post?           @relation("PublishEvent")
  threads      CommentThread[]

  @@index([postId, createdAt])
  @@map("post_publication_event")
}

model SiteSettings {
  id                      Int              @id @default(1)
  defaultModerationPolicy ModerationPolicy @default(ALWAYS) @map("default_moderation_policy")
  trustThreshold          Int              @default(3) @map("trust_threshold")
  defaultColumnOrder      Json?            @map("default_column_order")

  @@map("site_settings")
}

model Commenter {
  id            String  @id @default(cuid())
  userId        String? @unique @map("user_id")
  email         String  @unique
  displayName   String  @map("display_name")
  approvedCount Int     @default(0) @map("approved_count")
  forceModerate Boolean @default(false) @map("force_moderate")

  user     User?     @relation(fields: [userId], references: [id])
  comments Comment[]

  @@map("commenter")
}

model CommentThread {
  id              String       @id @default(cuid())
  postId          String       @map("post_id")
  anchoredEventId String       @map("anchored_event_id")
  anchorFrom      Int          @map("anchor_from")
  anchorTo        Int          @map("anchor_to")
  quotedText      String       @map("quoted_text")
  status          ThreadStatus @default(ACTIVE)
  createdAt       DateTime     @default(now()) @map("created_at")

  post     Post                 @relation(fields: [postId], references: [id], onDelete: Cascade)
  event    PostPublicationEvent @relation(fields: [anchoredEventId], references: [id])
  comments Comment[]

  // Postgres indexes a primary key but never the referencing side of a
  // foreign key. post_metrics' comment counts walk post → thread → comment,
  // so without this the display path rescans this table per post on the page
  // (add_comment_count_indexes).
  @@index([postId])
  @@map("comment_thread")
}

model Comment {
  id                String        @id @default(cuid())
  threadId          String        @map("thread_id")
  parentCommentId   String?       @map("parent_comment_id")
  commenterId       String        @map("commenter_id")
  body              Json
  status            CommentStatus @default(PENDING)
  ipAddress         String?       @map("ip_address")
  statusChangedById String?       @map("status_changed_by_id")
  statusChangedAt   DateTime?     @map("status_changed_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  editedAt          DateTime?     @map("edited_at")
  deletedByUserId   String?       @map("deleted_by_user_id")
  deletedAt         DateTime?     @map("deleted_at")

  thread          CommentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  parent          Comment?      @relation("CommentReplies", fields: [parentCommentId], references: [id])
  replies         Comment[]     @relation("CommentReplies")
  commenter       Commenter     @relation(fields: [commenterId], references: [id])
  statusChangedBy User?         @relation("CommentStatusChangedBy", fields: [statusChangedById], references: [id])
  deletedBy       User?         @relation("CommentDeletedBy", fields: [deletedByUserId], references: [id])

  // The other half of post_metrics' count path — see CommentThread.postId.
  @@index([threadId])
  @@map("comment")
}

// A living document — PLAN.md §12 — read as its current Yjs state (Doc ↔
// Ydoc joined only by id derivation, ydocIdForDoc/docIdFromYdocId in
// src/lib/ydoc-names.ts; deliberately no foreign key either way, since it's
// a function of docId and cannot drift). No moderationPolicy: annotations
// are never moderated. No publishRevisionId/publishedAt: a doc is never
// "published at a revision" — readers see the live doc. No doc_revision
// table yet either (§12m, held back pending review).
//
// title/proseJson are caches of the ydoc's "title"/"default" Yjs fragments,
// written by server/doc-cache.ts on the collab server's store debounce
// (§12d) — nullable because they're empty until the first store, i.e. for a
// doc that's been created but never edited.
model Doc {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  visibility      DocVisibility @default(PRIVATE)
  proseJson       Json?         @map("prose_json")
  // Character count of proseJson, maintained by the doc_sync_prose_json_length
  // trigger — never assign to it. A plain column rather than a GENERATED one
  // because Prisma reads a generated column's expression as a default and
  // would offer to strip it on every migrate (add_doc_prose_json_length), and
  // a stored column rather than a doc_metrics view column because a view
  // recomputes the recursive walk per query — for every doc in the table when
  // sorting by it, not just the page. @default(0) so
  // `doc.create()` needn't name it; the trigger overwrites it on INSERT
  // anyway.
  proseJsonLength Int           @default(0) @map("prose_json_length")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedByUserId String?       @map("deleted_by_user_id")
  deletedAt       DateTime?     @map("deleted_at")

  authors           DocAuthor[]
  deletedBy         User?                  @relation("DocDeletedBy", fields: [deletedByUserId], references: [id])
  slugHistory       DocSlugHistory[]
  annotations       Annotation[]
  docLinks          DocLink[]
  posts             Post[]
  publicationEvents PostPublicationEvent[]
  metrics           DocMetrics?

  @@map("doc")
}

// The joined byline /docs shows as "Author(s)", as a database view (PLAN.md
// §16e/§16l). Same caveats as PostMetrics; see add_doc_metrics_view.
//
// Unlike PostMetrics this is built by grouping doc_author rather than by
// selecting FROM doc, so it never references the base table. That is what
// keeps Prisma's LEFT JOIN back to doc from scanning it twice on every sort
// through the view — Postgres 18's self-join elimination only collapses INNER
// joins, so the second scan has to be removed rather than optimised away.
// /docs' other derived value, Length, would have forced this view to read doc;
// it is a stored column instead (Doc.proseJsonLength).
view DocMetrics {
  docId String @unique @map("doc_id")
  // Never NULL in practice: a doc with no authors simply has no row here now
  // that the view groups doc_author, so the *relation* is the optional part.
  // Still declared nullable because a view's columns carry no NOT NULL.
  byline String? @map("byline")

  doc Doc @relation(fields: [docId], references: [id])

  @@map("doc_metrics")
}

model DocAuthor {
  docId       String @map("doc_id")
  userId      String @map("user_id")
  bylineOrder Int    @map("byline_order")

  doc  Doc  @relation(fields: [docId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([docId, userId])
  @@map("doc_author")
}

// Redirect sources for a doc's past slugs — same shape/rationale as
// PostSlugHistory. slug carries its own @unique, not @@unique([docId, slug]):
// doc slugs are unique among docs only (a separate /doc/* namespace with no
// shared catch-all against post slugs), enforced by docSlugInUse in
// src/lib/doc-slug.ts rather than by this column against Post/PostSlugHistory.
model DocSlugHistory {
  id        String   @id @default(cuid())
  docId     String   @map("doc_id")
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  doc Doc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([docId])
  @@map("doc_slug_history")
}

// PLAN.md §12c/§12i — a root annotation (parentAnnotationId null) *is* the
// thread; replies hang off it through the same self-FK shape
// Comment.parentCommentId already uses. No anchor columns — the anchor is a
// mark embedded in the doc's own ydoc (src/lib/annotation-extension.ts); no
// quotedText — the annotated text is read from Doc.proseJson through the
// mark, so there is nothing here that could fall out of sync with the
// document. No moderation columns: annotations are never moderated (status
// below is about visibility/notification, §13d, not approval).
//
// PLAN.md §13 — the body itself is a live ydoc (ydocIdForAnnotation(id),
// src/lib/ydoc-names.ts), the same substrate a doc itself uses (§11).
// proseJson/bodyText are caches of that ydoc, written by
// server/annotation-cache.ts's store-debounce exactly the way Doc.proseJson/
// Doc.title already are (§12d) — losing them costs a rebuild, not data. The
// old plain-text `body` {text} column is gone: every row was backfilled onto
// proseJson/bodyText (scripts/backfill-annotation-ydocs.ts, since deleted)
// before this column was dropped.
model Annotation {
  id                 String           @id @default(cuid())
  docId              String           @map("doc_id")
  parentAnnotationId String?          @map("parent_annotation_id")
  userId             String           @map("user_id")
  proseJson          Json?            @map("prose_json")
  bodyText           String           @default("") @map("body_text")
  status             AnnotationStatus @default(DRAFT)
  raisedAt           DateTime?        @map("raised_at")
  resolvedAt         DateTime?        @map("resolved_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  editedAt           DateTime?        @map("edited_at")
  deletedByUserId    String?          @map("deleted_by_user_id")
  deletedAt          DateTime?        @map("deleted_at")

  doc       Doc          @relation(fields: [docId], references: [id], onDelete: Cascade)
  parent    Annotation?  @relation("AnnotationReplies", fields: [parentAnnotationId], references: [id])
  replies   Annotation[] @relation("AnnotationReplies")
  user      User         @relation("AnnotationAuthor", fields: [userId], references: [id])
  deletedBy User?        @relation("AnnotationDeletedBy", fields: [deletedByUserId], references: [id])

  @@index([docId])
  @@map("annotation")
}

// PLAN.md §14 — a doc link joins a selection in one doc to a selection in
// another. Deliberately the opposite of Annotation's comment above: a doc
// link's anchor lives *outside* the document, in `mark`, rather than as a
// mark embedded in the doc's own ydoc (§14a explains why — a mark lives in
// exactly one document, and a link joins two). That means it CAN fall out of
// sync with the document, and §14d is the resolution/repair policy that pays
// for it. `mark_id` is the inline-mark path (§14b) — a future alternative
// anchor using the same style of mark Annotation uses — reserved but unused;
// exactly one of `mark_id`/`mark` is ever non-null, enforced by a hand-added
// CHECK constraint in this model's migration (Prisma has no CHECK DSL).
//
// Soft delete is `deletedAt` alone here, not the deletedByUserId+deletedAt
// pair every other soft-deletable model in this file uses — a deliberate,
// singular divergence (§14b/§14n): neither this model nor DocLinkGroup joins
// the $extends soft-delete filter in src/lib/prisma.ts (that covers only
// post/user/doc; annotation is excluded too, on the same grounds, and
// filters by hand) so there is no UI depending on "who deleted this," and
// the single column avoids a second named @relation to User on both models.
model DocLink {
  id             String    @id @default(cuid())
  docId          String    @map("doc_id")
  markId         String?   @map("mark_id")
  mark           Json?
  text           String?
  docLinkGroupId String    @map("doc_link_group_id")
  overrideColor  String?   @map("override_color")
  userId         String    @map("user_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  doc   Doc          @relation(fields: [docId], references: [id], onDelete: Cascade)
  group DocLinkGroup @relation(fields: [docLinkGroupId], references: [id], onDelete: Cascade)
  user  User         @relation(fields: [userId], references: [id])

  @@index([docId])
  @@index([docLinkGroupId])
  @@map("doc_link")
}

// PLAN.md §14h/§14i — the named grouping a doc_link belongs to; the group,
// not the individual link, is what the group bar's dropdown lists and what a
// pulse targets across both columns at once (data-doc-link-group-ids). Not
// created until there is something to save (§14i) — an eagerly-created empty
// group would be invisible in its own dropdown, whose membership rule is
// "has a link to either doc." Deleting the last link does not delete the
// group; deleting the group soft-deletes its links, since docLinkGroupId is
// required and an orphaned link is meaningless.
model DocLinkGroup {
  id            String    @id @default(cuid())
  name          String?
  text          String?
  overrideColor String?   @map("override_color")
  userId        String    @map("user_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  user  User      @relation(fields: [userId], references: [id])
  links DocLink[]

  @@index([userId])
  @@map("doc_link_group")
}

// A generic, standalone Yjs document store — PLAN.md §11. Keyed purely by the
// Hocuspocus documentName (a `ydoc:`-prefixed id when routed through
// server/ydoc-hooks.ts, see src/lib/ydoc-names.ts); no relation to Post or
// anything else. `ydoc` is the O(1) cold-open path (Y.encodeStateAsUpdate);
// `ydocUpdate` is the never-truncated-on-save raw update log, whose first row
// per document is always a full state and every later row a plain delta
// (invariant 1, PLAN.md §11b); `ydocSnapshot` is a checkpoint constructed
// on demand, never implicitly, that lets a truncation-aware reader resolve a
// replay base without walking the log from row 1 (invariant 2).
model Ydoc {
  id          String   @id
  ydoc        Bytes
  stateVector Bytes    @map("state_vector")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  updates   YdocUpdate[]
  snapshots YdocSnapshot[]

  @@index([updatedAt])
  @@map("ydoc")
}

model YdocUpdate {
  id        BigInt   @id @default(autoincrement())
  ydocId    String   @map("ydoc_id")
  update    Bytes
  createdAt DateTime @default(now()) @map("created_at")

  doc Ydoc @relation(fields: [ydocId], references: [id], onDelete: Cascade)

  @@index([ydocId, id])
  @@map("ydoc_update")
}

model YdocSnapshot {
  id               String   @id @default(cuid())
  ydocId           String   @map("ydoc_id")
  ydoc             Bytes
  stateVector      Bytes    @map("state_vector")
  lastYdocUpdateId BigInt   @map("last_ydoc_update_id")
  userId           String?  @map("user_id")
  createdAt        DateTime @default(now()) @map("created_at")

  doc               Ydoc                   @relation(fields: [ydocId], references: [id], onDelete: Cascade)
  user              User?                  @relation("YdocSnapshotUser", fields: [userId], references: [id])
  publicationEvents PostPublicationEvent[]

  @@index([ydocId, lastYdocUpdateId])
  @@map("ydoc_snapshot")
}
