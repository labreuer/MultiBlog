# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright
/e2e/.auth/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# claude code local settings (personal, not shared)
.claude/settings.local.json

# local DB backups (pg_dump), taken before risky schema/data work
/.db-backups

# scratch space for one-shot import sources (e.g. an Etherpad dirty.db) — real
# content, and large; see scripts/import-etherpad.ts
/temp

# landing-page banner (src/lib/site-banner.ts, PLAN.md §17b) — deployment
# content, not repository content, same reasoning as .env above
/public/banner.*

# site icons (scripts/build-icons.ts, docs/FAVICON.md) — deployment content,
# not repository content, same reasoning as the banner above. src/app/icon.png
# and src/app/icon1.png get Next's own build-time content hash in their
# emitted <link> href, which is the whole point (see docs/FAVICON.md) — none
# of that requires the files to be tracked. The master this script reads from
# is also kept out of git; it's deployment content too, just not one Next
# serves itself.
/src/app/icon.png
/src/app/icon1.png
/src/app/apple-icon.png
/public/favicon.ico
/public/icons/
/site-icons/

# Etherpad import inputs: a dump of somebody else's pad database and the
# author->email mapping derived from it. Both are real data, not fixtures.
dirty.db
etherpad-authors.json

# uploaded file bytes (src/lib/file-storage.ts, PLAN.md §19) — content-
# addressed by sha256, path from FILE_STORAGE_DIR. Deployment content like the
# banner above, but with one extra consequence worth remembering: this is a
# second backup surface, and `pg_dump` does not cover it (DEPLOY.md).
/.file-storage/
